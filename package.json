{
  "name": "git-good-tools",
  "displayName": "Git Good Tools",
  "description": "Git utilities for managing .gitignore entries and the Git index",
  "version": "0.1.0",
  "publisher": "lastwhisper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lastwhisper66/git-good-tools.git"
  },
  "bugs": {
    "url": "https://github.com/lastwhisper66/git-good-tools/issues"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "gitignore",
    "git index",
    "scm"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-good-tools.addToGitignore",
        "title": "Git Good Tools: Add to .gitignore",
        "category": "Git Good Tools"
      },
      {
        "command": "git-good-tools.removeFromGitIndex",
        "title": "Git Good Tools: Remove from Git Index",
        "category": "Git Good Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "git-good-tools.addToGitignore",
          "when": "resourceScheme == file",
          "group": "git-good-tools@1"
        },
        {
          "command": "git-good-tools.removeFromGitIndex",
          "when": "resourceScheme == file",
          "group": "git-good-tools@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
